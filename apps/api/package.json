{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@glossops/database": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "dotenv": "^16.5.0",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@auth$": "<rootDir>/auth/index.ts",
      "^@auth/decorators$": "<rootDir>/auth/decorators/index.ts",
      "^@auth/dto$": "<rootDir>/auth/dto/index.ts",
      "^@auth/guards$": "<rootDir>/auth/guards/index.ts",
      "^@auth/interfaces$": "<rootDir>/auth/interfaces/index.ts",
      "^@branches$": "<rootDir>/branches/index.ts",
      "^@branches/dto$": "<rootDir>/branches/dto/index.ts",
      "^@branches/interfaces$": "<rootDir>/branches/interfaces/index.ts",
      "^@config$": "<rootDir>/config/index.ts",
      "^@customer-assets$": "<rootDir>/customer-assets/index.ts",
      "^@customer-assets/dto$": "<rootDir>/customer-assets/dto/index.ts",
      "^@customer-assets/interfaces$": "<rootDir>/customer-assets/interfaces/index.ts",
      "^@customers$": "<rootDir>/customers/index.ts",
      "^@customers/dto$": "<rootDir>/customers/dto/index.ts",
      "^@customers/interfaces$": "<rootDir>/customers/interfaces/index.ts",
      "^@organizations$": "<rootDir>/organizations/index.ts",
      "^@organizations/dto$": "<rootDir>/organizations/dto/index.ts",
      "^@organizations/interfaces$": "<rootDir>/organizations/interfaces/index.ts",
      "^@prisma$": "<rootDir>/prisma/index.ts",
      "^@services$": "<rootDir>/services/index.ts",
      "^@services/dto$": "<rootDir>/services/dto/index.ts",
      "^@services/interfaces$": "<rootDir>/services/interfaces/index.ts",
      "^@suppliers$": "<rootDir>/suppliers/index.ts",
      "^@suppliers/dto$": "<rootDir>/suppliers/dto/index.ts",
      "^@suppliers/interfaces$": "<rootDir>/suppliers/interfaces/index.ts",
      "^@brands$": "<rootDir>/brands/index.ts",
      "^@brands/dto$": "<rootDir>/brands/dto/index.ts",
      "^@brands/interfaces$": "<rootDir>/brands/interfaces/index.ts",
      "^@work-orders$": "<rootDir>/work-orders/index.ts",
      "^@work-orders/dto$": "<rootDir>/work-orders/dto/index.ts",
      "^@work-orders/interfaces$": "<rootDir>/work-orders/interfaces/index.ts",
      "^@inventory$": "<rootDir>/inventory/index.ts",
      "^@inventory/dto$": "<rootDir>/inventory/dto/index.ts",
      "^@inventory/interfaces$": "<rootDir>/inventory/interfaces/index.ts",
      "^@purchase-orders$": "<rootDir>/purchase-orders/index.ts",
      "^@purchase-orders/dto$": "<rootDir>/purchase-orders/dto/index.ts",
      "^@purchase-orders/interfaces$": "<rootDir>/purchase-orders/interfaces/index.ts",
      "^@asset-checkpoints$": "<rootDir>/asset-checkpoints/index.ts",
      "^@asset-checkpoints/dto$": "<rootDir>/asset-checkpoints/dto/index.ts",
      "^@asset-checkpoints/interfaces$": "<rootDir>/asset-checkpoints/interfaces/index.ts",
      "^@activity-logs$": "<rootDir>/activity-logs/index.ts",
      "^@activity-logs/dto$": "<rootDir>/activity-logs/dto/index.ts",
      "^@activity-logs/interfaces$": "<rootDir>/activity-logs/interfaces/index.ts",
      "^@work-order-assignments$": "<rootDir>/work-order-assignments/index.ts",
      "^@work-order-assignments/dto$": "<rootDir>/work-order-assignments/dto/index.ts",
      "^@work-order-assignments/interfaces$": "<rootDir>/work-order-assignments/interfaces/index.ts"
    }
  }
}
